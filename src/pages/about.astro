---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';
import YouTube from '../components/YouTube.astro';
import Video from '../components/Video.astro';
import SizedImage from '../components/SizedImage.astro';

const companies = (await getCollection('companies')).sort(
  (a, b) => a.data.order - b.data.order || a.data.name.localeCompare(b.data.name),
);
const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
);
const experience = await Promise.all(companies.map(async (company) => ({
  ...company,
  projects: await Promise.all(projects
    .filter((project) => project.data.company.id === company.id)
    .map(async (project) => ({ ...project, Content: (await render(project)).Content }))),
})));
---
<BaseLayout title="About" description="About Fraser Hutchison, a technical artist working in games.">
  <article class="about shell">
    <section class="about-intro">
      <div class="profile-frame">
        <img class="profile-picture" src="/about/profile-picture.webp" alt="Fraser Hutchison" width="512" height="300" />
      </div>
      <div class="about-copy">
        <p class="eyebrow">Fraser Hutchison</p>
        <h1>Technical Artist</h1>
        <p>Hi, I’m Fraser. I’m a technical artist interested in graphics and pipeline development for games, but frankly, I’m interested in just about every aspect of game development.</p>
        <p>Most of my time is spent in Unity, though I also delve into DCC tooling, profiling, documentation, and whatever else happens to catch my interest.</p>
        <p>Outside of games, I read a lot and watch probably too many films and TV shows.</p>
        <div class="links">
          <a href={SITE.social.github}><img src="/icons/github.svg" alt="" />GitHub</a>
          <a href={SITE.social.linkedin}><img src="/icons/linkedin.svg" alt="" />LinkedIn</a>
          <a href={SITE.social.artstation}><img src="/icons/artstation.svg" alt="" />ArtStation</a>
        </div>
      </div>
    </section>

    <section class="projects" aria-label="Experience">
      <div class="experience-list">
        {experience.filter((company) => company.projects.length > 0).map((company) => (
          <section class="experience" aria-labelledby={`${company.id}-heading`}>
            <header class="experience-heading">
              <div class="company-lockup">
                <img src={company.data.logo} alt="" width="52" height="52" loading="lazy" />
                <div><h3 id={`${company.id}-heading`}>{company.data.name}</h3><p>{company.data.role}</p></div>
              </div>
              <p class="tenure">{company.data.tenure}</p>
            </header>
            <div class="games-list">
              {company.projects.map(({ data: game, body, Content }) => (
                <article class="project-entry">
                  <a class="game" href={game.url} target="_blank" rel="noreferrer">
                    <img class="game-cover" src={game.image} alt={game.alt} width="104" height="104" loading="lazy" />
                    <div><p class="eyebrow">{game.platform}</p><h4>{game.title}</h4></div>
                  </a>
                  {body?.trim() && <div class="project-description"><Content components={{ YouTube, Video, SizedImage }} /></div>}
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>
    </section>
  </article>
</BaseLayout>
