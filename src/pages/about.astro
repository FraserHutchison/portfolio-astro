---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';

const hardlightGames = [
  {
    title: 'Sonic Dream Team',
    platform: 'Apple Arcade',
    image: '/about/sonic-dream-team.webp',
    alt: 'Sonic Dream Team cover artwork',
    url: 'https://apps.apple.com/us/app/sonic-dream-team/id1609094795',
  },
  {
    title: 'Sonic Forces: Speed Battle',
    platform: 'Mobile',
    image: '/about/sonic-forces.webp',
    alt: 'Sonic Forces: Speed Battle cover artwork',
    url: 'https://play.google.com/store/apps/details?id=com.sega.sprint',
  },
  {
    title: 'Sonic Dash',
    platform: 'Mobile',
    image: '/about/sonic-dash.webp',
    alt: 'Sonic Dash cover artwork',
    url: 'https://play.google.com/store/apps/details?id=com.sega.sonicdash',
  },
  {
    title: 'Sonic Racing',
    platform: 'Mobile',
    image: '/about/sonic-racing.webp',
    alt: 'Sonic Racing artwork',
    url: 'https://apps.apple.com/us/app/sonic-racing/id1358659909',
  },
];

const frontierGames = [
  {
    title: 'F1 Manager 2022',
    platform: 'PC & Console',
    image: '/about/f1-manager-2022.png',
    alt: 'F1 Manager 2022 cover artwork',
    url: 'https://www.f1manager.com/2022',
  },
];
---
<BaseLayout title="About" description="About Fraser Hutchison, a technical artist working in games.">
  <article class="about shell">
    <section class="about-intro">
      <div class="profile-frame">
        <img class="profile-picture" src="/about/profile-picture.webp" alt="Fraser Hutchison" width="512" height="300" />
      </div>
      <div class="about-copy">
        <p class="eyebrow">Fraser Hutchison</p>
        <h1>Technical Artist</h1>
        <p>Hi, I’m Fraser. I’m a technical artist interested in graphics and pipeline development for games, but frankly, I’m interested in just about every aspect of game development.</p>
        <p>Most of my time is spent in Unity, though I also delve into DCC tooling, profiling, documentation, and whatever else happens to catch my interest.</p>
        <p>Outside of games, I read a lot and watch probably too many films and TV shows.</p>
        <div class="links">
          <a href={SITE.social.github}><img src="/icons/github.svg" alt="" />GitHub</a>
          <a href={SITE.social.linkedin}><img src="/icons/linkedin.svg" alt="" />LinkedIn</a>
          <a href={SITE.social.artstation}><img src="/icons/artstation.svg" alt="" />ArtStation</a>
        </div>
      </div>
    </section>

    <section class="projects" aria-label="Experience">
      <div class="experience-list">
        <section class="experience" aria-labelledby="hardlight-heading">
          <header class="experience-heading">
            <div class="company-lockup">
              <img src="/about/sega-hardlight.png" alt="" />
              <div><h3 id="hardlight-heading">SEGA HARDlight</h3><p>Technical Artist</p></div>
            </div>
            <p class="tenure">February 2022 — Present</p>
          </header>
          <div class="games-list">
            {hardlightGames.map((game) => (
              <a class="game" href={game.url} target="_blank" rel="noreferrer">
                <img class="game-cover" src={game.image} alt={game.alt} width="104" height="104" loading="lazy" />
                <div><p class="eyebrow">{game.platform}</p><h4>{game.title}</h4></div>
              </a>
            ))}
          </div>
        </section>
        <section class="experience" aria-labelledby="frontier-heading">
          <header class="experience-heading">
            <div class="company-lockup">
              <img class="frontier-logo" src="/about/frontier-developments.webp" alt="" />
              <div><h3 id="frontier-heading">Frontier Developments</h3><p>3D Artist</p></div>
            </div>
            <p class="tenure">July 2021 — February 2022</p>
          </header>
          <div class="games-list">
            {frontierGames.map((game) => (
              <a class="game" href={game.url} target="_blank" rel="noreferrer">
                <img class="game-cover" src={game.image} alt={game.alt} width="104" height="104" loading="lazy" />
                <div><p class="eyebrow">{game.platform}</p><h4>{game.title}</h4></div>
              </a>
            ))}
          </div>
        </section>
      </div>
    </section>
  </article>
</BaseLayout>
