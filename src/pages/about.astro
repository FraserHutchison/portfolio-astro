---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="About" description="About Fraser Hutchison, a technical artist working in games.">
  <article class="about shell">
    <section class="about-intro">
      <img class="profile-picture" src="/about/profile-picture.jpg" alt="Fraser Hutchison" width="512" height="512" />
      <div class="about-copy">
        <p class="eyebrow">Fraser Hutchison</p>
        <h1>Technical Artist</h1>
        <p>I’m Fraser Hutchison, a technical artist working across rendering, shaders, optimisation and art tools for games.</p>
        <p>My work sits between art and engineering: building visual systems, helping artists work efficiently, and finding practical ways to make ambitious visuals perform across a wide range of hardware.</p>
        <p>My professional work includes projects at SEGA HARDlight and Frontier Developments, with a particular focus on Unity, URP, mobile rendering and production-friendly shader workflows.</p>
        <div class="links">
          <a href="https://github.com/FraserHutchison"><img src="/icons/github.svg" alt="" />GitHub</a>
          <a href="https://www.linkedin.com/in/fraser-hutchison-011b0b178/"><img src="/icons/linkedin.svg" alt="" />LinkedIn</a>
          <a href="https://www.artstation.com/fraserhutchison"><img src="/icons/artstation.svg" alt="" />ArtStation</a>
        </div>
      </div>
    </section>

    <section class="projects" aria-labelledby="projects-heading">
      <header class="projects-head">
        <h2 id="projects-heading">Experience</h2>
      </header>
      <div class="experience-list">
        <section class="experience" aria-labelledby="hardlight-heading">
          <header class="experience-heading">
            <div class="company-lockup">
              <img src="/about/sega-hardlight.png" alt="" />
              <div><h3 id="hardlight-heading">SEGA HARDlight</h3><p>Technical Artist</p></div>
            </div>
            <p class="tenure">February 2022 — Present</p>
          </header>
          <div class="games-list">
            <article class="game">
              <img class="game-cover" src="/about/sonic-dream-team.jpg" alt="Sonic Dream Team cover artwork" width="1024" height="1024" loading="lazy" />
              <div><p class="eyebrow">Apple Arcade</p><h4>Sonic Dream Team</h4></div>
            </article>
            <article class="game">
              <img class="game-cover" src="/about/sonic-forces.png" alt="Sonic Forces: Speed Battle cover artwork" width="1200" height="630" loading="lazy" />
              <div><p class="eyebrow">Mobile</p><h4>Sonic Forces: Speed Battle</h4></div>
            </article>
            <article class="game">
              <img class="game-cover" src="/about/sonic-dash.png" alt="Sonic Dash cover artwork" width="1200" height="630" loading="lazy" />
              <div><p class="eyebrow">Mobile</p><h4>Sonic Dash</h4></div>
            </article>
          </div>
        </section>
        <section class="experience" aria-labelledby="frontier-heading">
          <header class="experience-heading">
            <div class="company-lockup">
              <img src="/about/frontier-developments.png" alt="" />
              <div><h3 id="frontier-heading">Frontier Developments</h3><p>3D Artist</p></div>
            </div>
            <p class="tenure">July 2021 — February 2022</p>
          </header>
          <div class="games-list">
            <article class="game">
              <img class="game-cover" src="/about/f1-manager-2022.png" alt="F1 Manager 2022 cover artwork" width="385" height="513" loading="lazy" />
              <div><p class="eyebrow">PC &amp; Console</p><h4>F1 Manager 2022</h4></div>
            </article>
          </div>
        </section>
      </div>
    </section>
  </article>
</BaseLayout>
