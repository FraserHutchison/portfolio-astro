---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostPreview from '../components/PostPreview.astro';
import UnityIconStrip from '../components/UnityIconStrip.astro';
import YouTube from '../components/YouTube.astro';
import Video from '../components/Video.astro';
import SizedImage from '../components/SizedImage.astro';
import { sortPosts } from '../utils/posts';

const home = await getEntry('pages', 'home');
if (!home) throw new Error('Missing homepage content: src/content/pages/home.mdx');
const { Content: HomeContent } = await render(home);

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(sortPosts);
---
<BaseLayout title={home.data.title} description={home.data.description}>
  <div class="hero-grid">
    <section class="intro shell">
      <p class="eyebrow">{home.data.role}</p>
      <h1>{home.data.name}</h1>
      <div class="intro-copy"><HomeContent components={{ YouTube, Video, SizedImage }} /></div>
      {home.data.links.length > 0 && <div class="links">
        {home.data.links.map((link) => (
          <a href={link.url}>{link.icon && <img src={link.icon} alt="" />}{link.label}</a>
        ))}
      </div>}
      {home.data.hero && <img class="hero-artwork" src={home.data.hero.image} alt={home.data.hero.alt} width="1200" height="1200" />}
    </section>
    <UnityIconStrip />
  </div>
  <p class="project-count shell">PROJECTS / {posts.length.toString().padStart(2, '0')}</p>
  <section class="post-list shell" aria-label="Selected work and articles">
    {posts.map((post) => <PostPreview post={post} />)}
  </section>
</BaseLayout>
