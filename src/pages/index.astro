---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostPreview from '../components/PostPreview.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort((a, b) => {
  if (a.data.pinned !== b.data.pinned) return a.data.pinned ? -1 : 1;
  if (a.data.pinned && b.data.pinned) return (a.data.pinOrder ?? 999) - (b.data.pinOrder ?? 999);
  return b.data.date.valueOf() - a.data.date.valueOf();
});
---
<BaseLayout>
  <section class="intro shell">
    <p class="eyebrow">Technical Artist</p>
    <h1>Fraser Hutchison</h1>
    <p class="intro-copy">Technical artist specialising in Unity and URP rendering, shader development, and mobile optimisation for games including <em>Sonic Dream Team</em>.</p>
    <div class="links">
      <a href="https://github.com/FraserHutchison">GitHub</a>
      <a href="https://www.linkedin.com/in/fraser-hutchison/">LinkedIn</a>
    </div>
  </section>
  <section class="post-list shell" aria-label="Selected work and articles">
    {posts.map((post) => <PostPreview post={post} />)}
  </section>
</BaseLayout>
