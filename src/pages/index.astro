---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostPreview from '../components/PostPreview.astro';
import UnityIconStrip from '../components/UnityIconStrip.astro';
import { SITE } from '../config/site';
import { sortPosts } from '../utils/posts';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(sortPosts);
---
<BaseLayout>
  <div class="hero-grid">
    <section class="intro shell">
      <p class="eyebrow">Technical Artist</p>
      <h1>Fraser Hutchison</h1>
      <p class="intro-copy">Technical artist specialising in Unity and URP rendering, shader development, mobile optimisation, and production tools for artists.</p>
      <div class="links">
        <a href={SITE.social.github}><img src="/icons/github.svg" alt="" />GitHub</a>
        <a href={SITE.social.linkedin}><img src="/icons/linkedin.svg" alt="" />LinkedIn</a>
      </div>
      <img class="hero-artwork" src="/hero-artwork.svg" alt="" width="1200" height="1200" />
    </section>
    <UnityIconStrip />
  </div>
  <section class="post-list shell" aria-label="Selected work and articles">
    {posts.map((post) => <PostPreview post={post} />)}
  </section>
</BaseLayout>
