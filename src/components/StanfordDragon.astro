<div class="dragon-stage" role="img" aria-label="Interactive 3D material preview ball. Drag to rotate.">
  <div class="dragon-loading" aria-hidden="true">Loading preview…</div>
</div>

<script>
  const stages = document.querySelectorAll<HTMLElement>('.dragon-stage:not([data-ready])');

  stages.forEach((stage) => {
    stage.dataset.ready = 'true';

    const start = async () => {
      const [THREE, { OrbitControls }] = await Promise.all([
        import('three'),
        import('three/examples/jsm/controls/OrbitControls.js'),
      ]);

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(32, 1, 0.01, 100);
      const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true, powerPreference: 'high-performance' });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.75));
      renderer.setClearColor(0x000000, 0);
      renderer.outputColorSpace = THREE.SRGBColorSpace;
      stage.append(renderer.domElement);

      const controls = new OrbitControls(camera, renderer.domElement);
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      controls.enableDamping = true;
      controls.enablePan = false;
      controls.enableZoom = false;
      controls.autoRotate = !reduceMotion;
      controls.autoRotateSpeed = 0.8;

      scene.add(new THREE.HemisphereLight(0xffffff, 0x657079, 2.4));
      const key = new THREE.DirectionalLight(0xffffff, 3.2);
      key.position.set(3, 4, 5);
      scene.add(key);
      const rim = new THREE.DirectionalLight(0xaab4ba, 2);
      rim.position.set(-4, 2, -3);
      scene.add(rim);

      let visible = true;

      const geometry = new THREE.SphereGeometry(1.35, 96, 64);
      const position = geometry.attributes.position;
      const point = new THREE.Vector3();
      const directions = new Float32Array(position.count * 3);
      for (let index = 0; index < position.count; index += 1) {
        point.fromBufferAttribute(position, index);
        const direction = point.clone().normalize();
        directions[index * 3] = direction.x;
        directions[index * 3 + 1] = direction.y;
        directions[index * 3 + 2] = direction.z;
      }

      const updateSurface = (time = 0) => {
        for (let index = 0; index < position.count; index += 1) {
          const x = directions[index * 3];
          const y = directions[index * 3 + 1];
          const z = directions[index * 3 + 2];
          const ripple = Math.sin(y * 10 + x * 4 + time * 0.7) * 0.035;
          const detail = Math.sin(x * 7 - time * 0.45) * Math.sin(z * 7 + time * 0.35) * 0.022;
          const radius = 1.35 + ripple + detail;
          position.setXYZ(index, x * radius, y * radius, z * radius);
        }
        position.needsUpdate = true;
        geometry.computeVertexNormals();
      };
      updateSurface();

      const materialBall = new THREE.Mesh(
        geometry,
        new THREE.MeshLambertMaterial({ color: 0x8b8f91 }),
      );
      materialBall.rotation.set(-0.18, 0.35, 0.08);
      scene.add(materialBall);
      camera.position.set(0, 0, 6.6);
      controls.target.set(0, 0, 0);
      controls.update();
      stage.classList.add('is-loaded');

      const resize = () => {
        const { width, height } = stage.getBoundingClientRect();
        if (!width || !height) return;
        renderer.setSize(width, height, false);
        camera.aspect = width / height;
        camera.updateProjectionMatrix();
      };
      new ResizeObserver(resize).observe(stage);
      resize();

      new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; }).observe(stage);

      const render = () => {
        requestAnimationFrame(render);
        if (!visible) return;
        if (!reduceMotion) updateSurface(performance.now() * 0.001);
        controls.update();
        renderer.render(scene, camera);
      };
      render();
    };

    const loadObserver = new IntersectionObserver(([entry]) => {
      if (!entry.isIntersecting) return;
      loadObserver.disconnect();
      void start();
    }, { rootMargin: '200px' });
    loadObserver.observe(stage);
  });
</script>
