---
const icons = Array.from({ length: 10 }, (_, index) =>
  `/unity-icons/background-img-${String(index + 1).padStart(2, '0')}.png`
);
---
<section class="unity-strip" aria-label="Unity technical art tools">
  <div class="unity-strip-label shell">
    <span>Unity · Shaders · Rendering · Tools</span>
  </div>
  <div class="unity-strip-window">
    <div class="unity-strip-track">
      {[0, 1].map(() => (
        <div class="unity-icon-group" aria-hidden="true">
          {icons.map((src) => (
            <img src={src} alt="" width="256" height="256" loading="lazy" />
          ))}
        </div>
      ))}
    </div>
  </div>
</section>
