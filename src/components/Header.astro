---
import { SITE } from '../config/site';

const path = Astro.url.pathname;
---
<header class="site-header shell">
  <nav class="site-nav header-left" aria-label="Primary">
    <a class="home-mark" href="/" aria-label="Home"><img src="/favicon.ico" alt="" /></a>
    <a class="home-link" href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a>
    <a class="about-link" href="/about/" aria-current={path === '/about/' ? 'page' : undefined}>About</a>
  </nav>
  <a class="header-social" href={SITE.social.linkedin} rel="me noreferrer">
    <img src="/icons/linkedin.svg" alt="" />
    <span>LinkedIn</span>
  </a>
</header>
