---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  width?: string | number;
  align?: 'left' | 'center' | 'right';
  caption?: string;
}

const {
  src,
  alt,
  width = '100%',
  align = 'center',
  caption,
} = Astro.props;

const mediaWidth = typeof width === 'number' ? `${width}px` : width;
---

<figure class:list={['sized-image', `align-${align}`]} style={`--media-width: ${mediaWidth}`}>
  <Image {src} {alt} />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
